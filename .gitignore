# Built application files
*.apk
*.ap_

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
/.idea
!.idea/codeInsightSettings.xml
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# Intellij
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/dictionaries
.idea/libraries

# Mac
*.DS_Store

# Keystore files
*.jks

# Kotlin
.kotlin
.hotswan/

# Kotlin/JS & Wasm
node_modules/
kotlin-js-store/yarn.lock.bak

# Xcode
app/iosApp/build/
app/iosApp/DerivedData/
xcuserdata/
*.xcuserstate
*.xcworkspace/xcuserdata/

# Screenshot test failures
**/build/reports/roborazzi/
**/src/test/snapshots/**/*_compare.png

# Compose HotSwan captures are produced by CI and published to Pages, not committed.
.hotswan/

# Only the rendered PNG is committed. The Excalidraw source and the SVG intermediate stay in
# the generator project, so nothing here needs regenerating to build.
figure/*.svg
figure/*.excalidraw

# The upstream Now in Android checkout is a clone of another repository (it carries its own
# .git), so `git add` recorded it as a gitlink rather than as files. It is a local reference only:
# clone it yourself with the command in the README.
/nowinandroid/

# The Xcode project is generated from app/iosApp/project.yml by XcodeGen
# (./scripts/generate-xcodeproj.sh); committing it would just create churn.
app/iosApp/*.xcodeproj/
